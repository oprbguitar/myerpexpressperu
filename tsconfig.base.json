{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@erp/domain": ["packages/domain/src/index.ts"],
      "@erp/contracts": ["packages/contracts/src/index.ts"],
      "@erp/security": ["packages/security/src/index.ts"],
      "@erp/database": ["packages/database/src/index.ts"]
    }
  }
}
