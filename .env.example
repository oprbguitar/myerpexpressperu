NODE_ENV=development
APP_ENVIRONMENT=development
APP_URL=http://localhost:5273
APP_PUBLIC_URL=http://localhost:5273
API_URL=http://localhost:3100
VITE_API_URL=http://localhost:3100/api/v1
DATABASE_URL=postgresql://erp:erp_local_only@localhost:5432/erp_express
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL=28800
PASSWORD_RESET_TTL=1800
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_SECONDS=900
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=change-me-in-local-env
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=erp-private
STORAGE_ACCESS_KEY=erp-local
STORAGE_SECRET_KEY=replace-local-storage-secret
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=ERP Express Peru <no-reply@example.test>
LOG_LEVEL=info
COOKIE_SECURE=false
# Proxies de confianza (IP o CIDR separados por coma). Vacío = ignorar cabeceras de reenvío.
TRUSTED_PROXIES=
DEMO_MODE=false
DEMO_RESET_ENABLED=false
DEMO_TENANT_ID=
DEMO_DATABASE_FINGERPRINT=
DEMO_RESET_SCHEDULE=0 4 * * *
DEMO_MAX_USERS=25
DEMO_MAX_RECORDS=10000
ENCRYPTION_MASTER_KEY_REFERENCE=
PROVIDER_SECRET_STORE=environment
AI_ENABLED=false
AI_PROVIDER=none
AI_BASE_URL=
AI_MODEL=
AI_DAILY_BUDGET=0
AI_MONTHLY_BUDGET=0
AI_DATA_RETENTION=none
AI_LOG_CONTENT=false
OCR_ENABLED=false
OCR_PROVIDER=mock
OCR_BASE_URL=
OCR_MAX_FILE_SIZE=10485760
MAPS_ENABLED=false
GEOCODING_PROVIDER=manual
GEOCODING_BASE_URL=
LEGAL_OWNER_NAME=
LEGAL_CONTACT_EMAIL=
PRIVACY_CONTACT_EMAIL=
SUPPORT_EMAIL=
CONSUMER_CLAIMS_URL=
SECURITY_EVENT_EMAIL=
MALWARE_SCANNER_PROVIDER=none
